    "@earendil-works/pi-schema": "1.6.0",
    "@formatjs/intl-getcanonicallocales": "3.4.0",
    "@formatjs/intl-segmenter": "12.3.2",
    "@sinonjs/text-encoding": "0.7.3",
    "@ungap/structured-clone": "1.4.0",
