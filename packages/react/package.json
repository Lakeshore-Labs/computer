{
  "name": "@lakeshore-labs/computer-react",
  "version": "0.0.0",
  "description": "A terminal in the browser for a computer served by computer.TerminalHandler, on xterm.js.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./terminal.css": "./src/terminal.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./terminal.css": "./src/terminal.css"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "node --test 'src/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@types/react": "^19",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "~6.0.2",
    "vite": "^8.3.8"
  }
}
