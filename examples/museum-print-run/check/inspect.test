{
 NAME "Verify the completed queue independently"
 OPERATION Get-Jobs
 GROUP operation-attributes-tag
 ATTR charset attributes-charset utf-8
 ATTR language attributes-natural-language en
 ATTR uri printer-uri $uri
 ATTR keyword which-jobs completed
 ATTR keyword requested-attributes job-id,job-name,job-state,job-originating-user-name
 STATUS successful-ok
 EXPECT job-state WITH-VALUE 9
 EXPECT job-name WITH-VALUE Amended-postcards
 EXPECT job-originating-user-name WITH-VALUE museum-desk
 DISPLAY job-id
 DISPLAY job-name
 DISPLAY job-state
}
