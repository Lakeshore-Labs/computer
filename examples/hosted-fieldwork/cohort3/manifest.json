{
 "note": "Cohort 3 field cases, scripts as run on 2026-11-22. Predicates are evaluated on key=value lines of stdout by replay_manifest.py. Receipts record only the listed keys.",
 "cases": [
  {
   "id": "inat-lynx",
   "servers": {
    "inat": "https://inaturalist.caseyjhand.com/mcp"
   },
   "allow": [
    "https://api.inaturalist.org/",
    "https://www.wikidata.org/"
   ],
   "inputs": {
    "name": "Lynx pardinus",
    "taxon_id": 41975,
    "wikidata": "Q129727 P141",
    "filters": "quality_grade=research, captive=false (REST)"
   },
   "predicates": [
    {
     "type": "contains",
     "text": "taxon_id=41975"
    },
    {
     "type": "contains",
     "text": "common=Iberian Lynx"
    },
    {
     "type": "contains",
     "text": "mcp_global_status=VU"
    },
    {
     "type": "within",
     "desc": "MCP research-grade count vs iNaturalist REST",
     "a": "mcp_research_obs",
     "b": "rest_research_obs",
     "pct": 3
    },
    {
     "type": "flag",
     "desc": "Wikidata IUCN item is Vulnerable (Q278113)",
     "key": "wikidata_is_vulnerable"
    }
   ],
   "record": [
    "taxon_id",
    "mcp_global_status",
    "mcp_research_obs",
    "rest_research_obs",
    "wikidata_iucn_item"
   ]
  },
  {
   "id": "gbif-lynx",
   "servers": {
    "gbif": "https://gbif-biodiversity.caseyjhand.com/mcp"
   },
   "allow": [
    "https://api.gbif.org/"
   ],
   "inputs": {
    "name": "Lynx pardinus",
    "taxon_key": 2435261,
    "note": "MCP excludes ABSENT records by default; compared with REST PRESENT"
   },
   "predicates": [
    {
     "type": "eq",
     "desc": "taxon key equals GBIF REST",
     "a": "mcp_taxon_key",
     "b": "rest_taxon_key"
    },
    {
     "type": "eq",
     "desc": "family equals GBIF REST",
     "a": "mcp_family",
     "b": "rest_family"
    },
    {
     "type": "within",
     "desc": "PRESENT count vs api.gbif.org",
     "a": "mcp_count",
     "b": "rest_count",
     "pct": 1
    },
    {
     "type": "eq",
     "desc": "arithmetic: REST PRESENT + ABSENT equals REST total",
     "a": "present_plus_absent",
     "b": "rest_total"
    },
    {
     "type": "contains",
     "text": "mcp_match_type=EXACT"
    }
   ],
   "record": [
    "mcp_taxon_key",
    "mcp_family",
    "mcp_count",
    "rest_count",
    "rest_absent",
    "rest_total",
    "present_plus_absent"
   ]
  },
